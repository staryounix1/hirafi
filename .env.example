# ===== قاعدة البيانات (PostgreSQL) =====
DATABASE_URL=postgresql://user:password@host:5432/hirafi
DB_DRIVER=pg
DB_POOL_MAX=10

# ===== المصادقة =====
JWT_SECRET=ضع-هنا-سلسلة-عشوائية-طويلة
AUTH_PROVIDER=local

# ===== التطبيق =====
APP_SLUG=hirafi
NODE_ENV=development
PORT=3000

# ===== التخزين (اختياري — لرفع صور الطلبات) =====
APP_STORAGE_PRESIGN_URL=
APP_STORAGE_TOKEN=

# Optional Supabase Storage fallback (used when the platform presign service is unavailable)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=hirafi-media
