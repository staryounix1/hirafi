# ===== قاعدة البيانات (PostgreSQL) =====
DATABASE_URL=postgresql://user:password@host:5432/hirafi
DB_DRIVER=tcp
DB_POOL_MAX=5

# ===== المصادقة =====
JWT_SECRET=ضع-هنا-سلسلة-عشوائية-طويلة
AUTH_PROVIDER=local

# ===== التطبيق =====
APP_SLUG=hirafi
NODE_ENV=development
PORT=3000

# ===== التخزين (اختياري — لرفع صور الطلبات) =====
APP_STORAGE_PRESIGN_URL=
APP_STORAGE_TOKEN=
