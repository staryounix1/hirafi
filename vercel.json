{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5.0.0",
      "includeFiles": "dist/public/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
