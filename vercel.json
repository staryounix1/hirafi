{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "functions": {
    "api/index.ts": {
      "includeFiles": ["dist/public/**"]
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
